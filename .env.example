APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://webhook:webhook@postgres:5432/webhook?sslmode=disable
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=webhook:deliveries
REDIS_CONSUMER_GROUP=webhook-workers

DELIVERY_CONNECT_TIMEOUT=2s
DELIVERY_REQUEST_TIMEOUT=10s
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BASE_BACKOFF=1s
DELIVERY_MAX_BACKOFF=60s

PAYLOAD_MAX_BYTES=262144
RESPONSE_CAPTURE_MAX_BYTES=16384

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_COOLDOWN=30s

OUTBOX_POLL_INTERVAL=500ms
WORKER_COUNT=4
# Optional per-process cap for one target; 0 disables, otherwise <= WORKER_COUNT.
# Saturated work is durably deferred without consuming an HTTP attempt.
WORKER_TARGET_CONCURRENCY=0
# DESTRUCTIVE when enabled: deletes old successful/canceled events and history.
# Ends their audit and ingestion-idempotency window. Back up before opting in.
HISTORY_RETENTION_AGE=0s
HISTORY_RETENTION_INTERVAL=1h
HISTORY_RETENTION_BATCH=100
# Optional admission-control bound (DECISIONS.md #28): reject new events
# with 429 once this many non-terminal, non-DLQ rows exist durably.
# 0 disables the limit (default: current behavior).
EVENTS_MAX_PENDING_EVENTS=0
# Prevents the Prometheus host-port publish from colliding with the
# target-simulator's own host port 9090 (both containers listen on
# container-internal 9090; see DECISIONS.md #25).
PROMETHEUS_PORT=9091

# Set only for local development when the bundled target simulator must be reachable via a private/loopback address.
ALLOW_PRIVATE_TARGETS=false

# Non-local environments should require API authentication.
AUTH_ENABLED=false
API_KEY=

# Base64-encoded 32-byte key used to encrypt target secrets at rest
# (AES-256-GCM). Generate a real value with: openssl rand -base64 32
# This is a development-only placeholder; never reuse it outside local dev.
SECRET_ENCRYPTION_KEY=
