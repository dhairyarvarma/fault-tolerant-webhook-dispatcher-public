+
+func (p *Pool) releaseTarget(id string) {
+	if p.targetLimit == 0 {
+		return
+	}
+	p.targetMu.Lock()
+	defer p.targetMu.Unlock()
+	if p.targetActive[id] <= 1 {
+		delete(p.targetActive, id)
+	} else {
+		p.targetActive[id]--
+	}
