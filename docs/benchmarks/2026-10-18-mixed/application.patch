+func (p *Pool) acquireTarget(id string) bool {
+	if p.targetLimit == 0 {
+		return true
+	}
+	p.targetMu.Lock()
+	defer p.targetMu.Unlock()
+	if p.targetActive[id] >= p.targetLimit {
